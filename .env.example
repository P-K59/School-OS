# InnovatMind School OS — Environment Configuration Template
# ==========================================================

# 1. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Google OAuth 2.0 Client Credentials
# Create credentials in Google Cloud Console:
# 1. Visit https://console.cloud.google.com/apis/credentials
# 2. Click "Create Credentials" -> "OAuth client ID"
# 3. Application Type: Web application
# 4. Name: InnovatMind School OS
# 5. Authorized JavaScript origins:
#    - http://localhost:3000 (Local Development)
#    - https://schoolos.innovatmind.com (Production)
# 6. Authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google (Local Development)
#    - https://schoolos.innovatmind.com/api/auth/callback/google (Production)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 3. Supabase Multi-Tenant Production Integration
NEXT_PUBLIC_SUPABASE_URL=https://gbtwchghqiaozyhoiobc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy alias support (if using anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 4. Central Data Environment Mode ('PRODUCTION' for live deployments, 'DEMO' for preview sandbox)
NEXT_PUBLIC_DATA_MODE=PRODUCTION

